offset_top = 3.0
offset_right = 201.0
offset_bottom = 279.0
theme_override_colors/search_result_color = Color(0.23483175, 0.26309335, 0.5648549, 1)
theme_override_colors/font_color = Color(0.875, 0.875, 0.875, 1)
theme_override_font_sizes/font_size = 4
text = "Objective: Eliminate enemies on all the islands to win.

- Eliminate all enemies per island in order to enable raft travelling to the next island 
and to unlock the chests on the islands (not on starting island)
- Use the item shop at the starting island to buy weapon, armor upgrades, and night vision 
(Important for seeing in the dark.)

- Resource usage: 
- scraps are used to purchase item upgrades (dropped by zombies or chest)
- wood is used to repair raft damage (dropped by zombies or chest)
- apples are used to heal player health (dropped by chest)

Buttons: 
- WASD or Arrow keys to move
- I (toggle inventory)
- R (to eat apple, heal player heath)
- K (to use wood, heal raft health)
- ESC (toggle pause menu)

Damage: 
- sharks deal raft damage
- zombies deal player damage
- timer deals damage to player when reaching zero
"

